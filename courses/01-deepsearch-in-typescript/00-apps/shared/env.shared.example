# Copy to shared/.env.shared and fill in secrets. Then run: pnpm sync-env
# This file is synced into every app's .env — edit shared/.env.shared only.

# --- OpenRouter (model selection for all apps) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_HIGH=google/gemma-4-31b-it:free
OPENROUTER_MODEL_FAST=google/gemma-4-26b-a4b-it:free

# --- Auth ---
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai-app-template

# --- Redis ---
REDIS_URL=redis://default:redis-pw@localhost:6379

# --- Search (apps with deep search) ---
# Preferred provider — automatically falls back to the other when unavailable
# (credits exhausted, rate limited, missing key, etc.)
SEARCH_PROVIDER=tavily
SERPER_API_KEY=

# --- Langfuse (apps with tracing) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# --- Tavily ---
TAVILY_API_KEY=

# --- BASE ---
EVAL_DATASET=dev
SEARCH_RESULTS_COUNT=3
SCRAPE_URLS_COUNT=4
MAX_AGENT_STEPS=3
MAX_DURATION_SECONDS=120
SESSION_TOKEN_BUDGET=200000
